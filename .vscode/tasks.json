{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "Run OpenKNXproducer (TP)",
            "type": "shell",
            "command": "~/bin/OpenKNXproducer.exe",
            "args": [
                "create",
                "--Debug",
                "-h",
                "include/knxprod.h",
                "src/OAM_PowerAmp"
            ],
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Create Dependencies",
