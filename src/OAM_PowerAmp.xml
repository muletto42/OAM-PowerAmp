<?xml version="1.0" encoding="utf-8"?>
  <KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
   
  <!--
    KoSingleOffset="20"   das sind die aus .share.xml 
    KoOffset="25"  >  das sind die aus .templ.xml 
    Beide sind komplett unabhängig voneinander. Man kann also dumme Dinge tun - aufpassen!
  -->

  <op:config href="OAM_PowerAmp.conf.xml" />
  
  <op:config name="%DFA_NumChannels%"        value="7" />
  <op:config name="%LOG_NumChannels%"        value="10" /> 
  <op:config name="%SWA_NumChannels%"        value="2" /> 
  <op:config name="%AMP_NumChannels%"        value="2" />

  <op:ETS OpenKnxId="0xAF"
    ApplicationNumber="42"
    ApplicationVersion="0.2"
    ReplacesVersions="0.0"
    ApplicationRevision="0.1"
    ProductName="PowerAmp"  
    ApplicationName="PowerAmp"
    BuildSuffix="-dev"
    BuildSuffixText="(dev)"
    OrderNumber="PowerAmp"
  />

  <!-- 
  KOs [1,20[
  -->
  <op:define prefix="BASE" ModuleType="10"
    share="../lib/OGM-Common/src/Common.share.xml">
    <op:verify File="../lib/OGM-Common/library.json" ModuleVersion="%BASE_VerifyVersion%" />
  </op:define>

<!-- no KOs -->
  <op:define prefix="UCT"
    share="../../OFM-ConfigTransfer/src/ConfigTransfer.share.xml"
    noConfigTransfer="true"
    ModuleType="19">
    <op:verify File="../../OFM-ConfigTransfer/library.json" ModuleVersion="%UCT_VerifyVersion%" />
  </op:define>

<!-- aktuell
  16 KOs / Channel
  => 2Channels*16KOs=32 KOs
  => [30,70[ -->
  <op:define prefix="AMP" 
    share="../lib/OFM-PowerAmp/src/PowerAmp.share.xml"
    template="../lib/OFM-PowerAmp/src/PowerAmp.templ.xml"
    NumChannels="%AMP_NumChannels%"
    KoSingleOffset="20" 
    KoOffset="25" 
    ModuleType="99">
  </op:define>

    <!--
  5 KOs / Channel
  => 2Channels*5KOs=10 KOs
  => [100,1010[
  -->
 <op:define prefix="SWA"
    share="../lib/OFM-SwitchActuator/src/SwitchActuatorModule.share.xml"
    template="../lib/OFM-SwitchActuator/src/SwitchActuatorModule.templ.xml"
    NumChannels="%SWA_NumChannels%"
    KoSingleOffset="100"
    KoOffset="120"
    ModuleType="40">
    <op:verify File="../lib/OFM-SwitchActuator/library.json" ModuleVersion="%SWA_VerifyVersion%" />
  </op:define>

  <!--
  3 KOs / Channel
  => 10Channels*3KOs=30 KOs
  => [150,180[
  -->
  <op:define prefix="LOG"
             share="../lib/OFM-LogicModule/src/Logikmodul.share.xml" 
             template="../lib/OFM-LogicModule/src/Logikmodul.templ.xml"
             NumChannels="%LOG_NumChannels%"
             KoOffset="150" 
             ModuleType="50" >
    <op:verify File="../lib/OFM-LogicModule/library.json" ModuleVersion="%LOG_VerifyVersion%" />
  </op:define>
  <!-- 
  KOs [180,300[ reserved for other LOG Channels
  -->

<!-- 
  30 KOs / Channel
  => 2Channels*30KOs=60 KOs
  => [300,360[
  -->
  <!-- DFA-Modul muss einstelligen ModulType verwenden (verwendet übergroßen Id-Space) -->
  <op:define prefix="DFA"
             share="../lib/OFM-DFA/src/DfaModule.share.xml"
             template="../lib/OFM-DFA/src/DfaModule.templ.xml"
             NumChannels="%DFA_NumChannels%"
             KoOffset="300"
             ModuleType="6">
    <op:verify File="../lib/OFM-DFA/library.json" ModuleVersion="%DFA_VerifyVersion%" />
  </op:define>
  <!-- 
  KOs [360,..[ reserved for Channels 3..32
  -->

 <generate />
</KNX>